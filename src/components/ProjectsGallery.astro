---
import { projectsData } from '../data/projects';
import { dictionary } from '../i18n/ui';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const t = dictionary[lang] || dictionary.es;

const categories = [
  { id: 'all', key: 'gallery.all', label: t['gallery.all'] },
  { id: 'madera', key: 'gallery.wood', label: t['gallery.wood'] },
  { id: 'acero', key: 'gallery.steel', label: t['gallery.steel'] },
  { id: 'pasamanos', key: 'gallery.handrails', label: t['gallery.handrails'] },
  { id: 'cristal', key: 'gallery.glass', label: t['gallery.glass'] },
];
---

<div class="projects-gallery-wrapper">
  <!-- FILTER BUTTONS -->
  <div class="filter-controls">
    {categories.map((cat, idx) => (
      <button 
        class={`filter-btn ${idx === 0 ? 'active' : ''}`} 
        data-filter={cat.id}
        data-i18n={cat.key}
      >
        {cat.label}
      </button>
    ))}
  </div>

  <!-- GALLERY GRID -->
  <div class="gallery-grid" id="gallery-grid">
    {projectsData.map((project) => (
      <div 
        class="gallery-item" 
        data-category={project.category}
        data-title-es={project.title.es}
        data-title-en={project.title.en}
        data-image={project.image}
        data-desc-es={project.description.es}
        data-desc-en={project.description.en}
      >
        <div class="gallery-card gold-frame">
          <div class="gold-frame-inner card-inner">
            <div class="img-container">
              <img src={project.image} alt={project.title[lang]} loading="lazy" width="400" height="280" />
              <div class="overlay">
                <span class="view-btn">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                  <span data-i18n="gallery.expand">{t['gallery.expand']}</span>
                </span>
              </div>
            </div>
            <div class="card-caption">
              <span class="cat-tag">{project.categoryLabel[lang]}</span>
              <h4 class="project-card-title">{project.title[lang]}</h4>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- LIGHTBOX MODAL -->
  <div id="lightbox-modal" class="lightbox-modal">
    <div class="lightbox-content gold-frame">
      <button class="close-btn" id="modal-close" aria-label="Cerrar modal">&times;</button>
      <div class="gold-frame-inner modal-inner">
        <div class="modal-body">
          <div class="modal-img-box">
            <img id="modal-img" src="" alt="" />
          </div>
          <div class="modal-info">
            <span id="modal-cat" class="modal-cat-tag"></span>
            <h3 id="modal-title" class="heading-serif"></h3>
            <div class="gold-divider"><span class="gold-divider-icon">◆</span></div>
            <p id="modal-desc"></p>
            
            <a id="modal-wa-btn" href="#" target="_blank" rel="noopener" class="btn-modal-wa">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.572-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
              <span data-i18n="gallery.consult">{t['gallery.consult']}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Filtering logic
  const filterBtns = document.querySelectorAll('.filter-btn');
  const galleryItems = document.querySelectorAll('.gallery-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      galleryItems.forEach(item => {
        const cat = item.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Lightbox logic
  const modal = document.getElementById('lightbox-modal');
  const modalClose = document.getElementById('modal-close');
  const modalImg = document.getElementById('modal-img') as HTMLImageElement;
  const modalTitle = document.getElementById('modal-title');
  const modalDesc = document.getElementById('modal-desc');
  const modalCat = document.getElementById('modal-cat');
  const modalWaBtn = document.getElementById('modal-wa-btn') as HTMLAnchorElement;

  galleryItems.forEach(item => {
    item.addEventListener('click', () => {
      const currentLang = localStorage.getItem('site-lang') || 'es';
      const title = currentLang === 'en' ? (item.getAttribute('data-title-en') || '') : (item.getAttribute('data-title-es') || '');
      const desc = currentLang === 'en' ? (item.getAttribute('data-desc-en') || '') : (item.getAttribute('data-desc-es') || '');
      const image = item.getAttribute('data-image') || '';
      const cat = item.getAttribute('data-category') || '';

      if (modal && modalImg && modalTitle && modalDesc && modalCat && modalWaBtn) {
        modalImg.src = image;
        modalTitle.textContent = title;
        modalDesc.textContent = desc;
        modalCat.textContent = cat.toUpperCase();

        const message = currentLang === 'en' ? `Hello, I am interested in project: "${title}". I would like a quote.` : `Hola, estoy interesado en el proyecto: "${title}". Quisiera consultar presupuesto.`;
        modalWaBtn.href = `https://wa.me/34677472228?text=${encodeURIComponent(message)}`;

        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  if (modalClose && modal) {
    const closeModal = () => {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    };

    modalClose.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }
</script>

<style>
  .projects-gallery-wrapper {
    margin-top: 30px;
  }

  .filter-controls {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  .filter-btn {
    background: var(--color-card);
    color: var(--color-text-main);
    border: 1px solid var(--color-card-border);
    padding: 9px 18px;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .filter-btn:hover, .filter-btn.active {
    background: var(--color-gold);
    color: white;
    border-color: var(--color-gold);
    box-shadow: var(--shadow-sm);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 28px;
  }

  .gallery-item {
    cursor: pointer;
  }

  .gallery-card {
    background: var(--color-card);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
  }

  .gallery-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
  }

  .card-inner {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .img-container {
    position: relative;
    height: 280px;
    overflow: hidden;
    background: #100E0C;
  }

  .img-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.5s ease;
  }

  .gallery-card:hover .img-container img {
    transform: scale(1.06);
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(18, 16, 14, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .gallery-card:hover .overlay {
    opacity: 1;
  }

  .view-btn {
    background: var(--color-gold);
    color: white;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .card-caption {
    padding: 18px;
    flex-grow: 1;
  }

  .cat-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .card-caption h4 {
    font-size: 1.15rem;
    color: var(--color-text-main);
  }

  /* LIGHTBOX MODAL */
  .lightbox-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(10, 9, 8, 0.85);
    backdrop-filter: blur(8px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .lightbox-modal.active {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-content {
    background: var(--color-card);
    width: 100%;
    max-width: 900px;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
  }

  .close-btn {
    position: absolute;
    top: 16px;
    right: 20px;
    z-index: 10;
    background: var(--color-gold);
    color: white;
    border: none;
    font-size: 1.8rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    line-height: 1;
  }

  .modal-inner {
    padding: 32px;
  }

  .modal-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    align-items: center;
  }

  .modal-img-box img {
    width: 100%;
    max-height: 450px;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .modal-cat-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-gold);
    letter-spacing: 0.12em;
  }

  .modal-info h3 {
    font-size: 1.8rem;
    color: var(--color-text-main);
    margin-top: 4px;
  }

  .modal-info p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 24px;
  }

  .btn-modal-wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #25D366;
    color: white;
    padding: 12px 24px;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.88rem;
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.3);
    width: 100%;
  }

  .btn-modal-wa:hover {
    background: #1eb856;
  }

  @media (max-width: 768px) {
    .modal-body {
      grid-template-columns: 1fr;
    }
  }
</style>
