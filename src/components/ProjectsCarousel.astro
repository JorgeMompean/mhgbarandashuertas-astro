---
import { projectsData } from "../data/projects";
import { dictionary } from "../i18n/ui";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const t = dictionary[lang] || dictionary.es;
const featuredProjects = projectsData.filter((p) => p.featured);
---

<div class="carousel-container gold-frame">
  <div class="gold-frame-inner carousel-inner">
    <div class="carousel-track-wrapper">
      <div class="carousel-track" id="carousel-track">
        {
          featuredProjects.map((item, index) => (
            <div
              class={`carousel-slide ${index === 0 ? "active" : ""}`}
              data-index={index}
              data-title-es={item.title.es}
              data-title-en={item.title.en}
              data-desc-es={item.description.es}
              data-desc-en={item.description.en}
              data-cat-es={item.categoryLabel.es}
              data-cat-en={item.categoryLabel.en}
            >
              <div class="slide-grid">
                <div class="slide-image-box">
                  <img
                    src={item.image}
                    alt={item.title[lang]}
                    width="500"
                    height="340"
                  />
                </div>
                <div class="slide-content">
                  <span class="slide-tag">{item.categoryLabel[lang]}</span>
                  <h3 class="heading-serif slide-title carousel-item-title">{item.title[lang]}</h3>
                  <div class="gold-divider">
                    <span class="gold-divider-icon">◆</span>
                  </div>
                  <p class="slide-desc carousel-item-desc">{item.description[lang]}</p>

                  <div class="slide-action">
                    <a
                      href={`https://wa.me/34677472228?text=Hola,%20quisiera%20consultar%20por%20${encodeURIComponent(item.title[lang])}`}
                      target="_blank"
                      rel="noopener"
                      class="btn-gold"
                    >
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.572-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
                      </svg>
                      <span data-i18n="carousel.btn">{t["carousel.btn"]}</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- RECTANGULAR DISTINCT CONTROLS -->
    <div class="carousel-nav-bar">
      <button class="carousel-btn-nav" id="carousel-prev" aria-label="Anterior">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="19" y1="12" x2="5" y2="12"></line><polyline
            points="12 19 5 12 12 5"></polyline></svg
        >
        <span data-i18n="carousel.prev">{t["carousel.prev"]}</span>
      </button>

      <!-- DOTS -->
      <div class="carousel-dots" id="carousel-dots">
        {
          featuredProjects.map((_, index) => (
            <span
              class={`carousel-dot ${index === 0 ? "active" : ""}`}
              data-index={index}
            />
          ))
        }
      </div>

      <button
        class="carousel-btn-nav"
        id="carousel-next"
        aria-label="Siguiente"
      >
        <span data-i18n="carousel.next">{t["carousel.next"]}</span>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
            points="12 5 19 12 12 19"></polyline></svg
        >
      </button>
    </div>
  </div>
</div>

<script>
  let currentIndex = 0;
  const track = document.getElementById("carousel-track");
  const slides = document.querySelectorAll(".carousel-slide");
  const dots = document.querySelectorAll(".carousel-dot");
  const prevBtn = document.getElementById("carousel-prev");
  const nextBtn = document.getElementById("carousel-next");

  function updateCarousel(index: number) {
    if (!track || slides.length === 0) return;

    if (index < 0) currentIndex = slides.length - 1;
    else if (index >= slides.length) currentIndex = 0;
    else currentIndex = index;

    slides.forEach((slide, i) => {
      slide.classList.toggle("active", i === currentIndex);
    });

    dots.forEach((dot, i) => {
      dot.classList.toggle("active", i === currentIndex);
    });
  }

  if (prevBtn && nextBtn) {
    prevBtn.addEventListener("click", () => updateCarousel(currentIndex - 1));
    nextBtn.addEventListener("click", () => updateCarousel(currentIndex + 1));
  }

  dots.forEach((dot) => {
    dot.addEventListener("click", () => {
      const idx = parseInt(dot.getAttribute("data-index") || "0", 10);
      updateCarousel(idx);
    });
  });

  // Autoplay slider
  setInterval(() => {
    updateCarousel(currentIndex + 1);
  }, 6000);
</script>

<style>
  .carousel-container {
    background: var(--color-card);
    margin-top: 30px;
    position: relative;
  }

  .carousel-inner {
    padding: 32px;
  }

  .carousel-track-wrapper {
    overflow: hidden;
    position: relative;
    min-height: 380px;
  }

  .carousel-slide {
    display: none;
    animation: fadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .carousel-slide.active {
    display: block;
  }

  .slide-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 36px;
    align-items: stretch;
  }

  .slide-image-box {
    height: 340px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: #141210;
  }

  .slide-image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .slide-content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .slide-tag {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-gold);
    text-transform: uppercase;
  }

  .slide-title {
    font-size: 1.8rem;
    color: var(--color-text-main);
    margin-top: 4px;
  }

  .slide-desc {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    margin-bottom: 24px;
    line-height: 1.6;
    flex-grow: 1;
  }

  /* RECTANGULAR DISTINCT CONTROLS BAR (Not circular like BackToTop) */
  .carousel-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--color-card-border);
  }

  .carousel-btn-nav {
    background: var(--color-dark-box);
    color: var(--color-gold-light);
    border: 1px solid var(--color-gold);
    padding: 8px 18px;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
  }

  .carousel-btn-nav:hover {
    background: var(--color-gold);
    color: #ffffff;
    box-shadow: var(--shadow-gold);
  }

  .carousel-dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .carousel-dot {
    width: 24px;
    height: 4px;
    border-radius: 2px;
    background: var(--color-card-border);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .carousel-dot.active {
    background: var(--color-gold);
    width: 36px;
  }

  @media (max-width: 800px) {
    .slide-grid {
      grid-template-columns: 1fr;
    }
    .slide-image-box {
      height: 220px;
    }
    .carousel-inner {
      padding: 18px;
    }
    .carousel-btn-nav span {
      display: none;
    }
  }
</style>
