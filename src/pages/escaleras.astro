---
import Layout from '../layouts/Layout.astro';
import { dictionary } from '../i18n/ui';

const urlLang = Astro.url.searchParams.get('lang') as 'es' | 'en' || 'es';
const t = dictionary[urlLang] || dictionary.es;

const pasamanosOptions = [
  {
    type: "steel-inox",
    titleKey: "stairs.mat.inox.title",
    descKey: "stairs.mat.inox.desc",
    tagKey: "stairs.mat.inox.tag"
  },
  {
    type: "steel-lacquered",
    titleKey: "stairs.mat.lacquer.title",
    descKey: "stairs.mat.lacquer.desc",
    tagKey: "stairs.mat.lacquer.tag"
  },
  {
    type: "wood-noble",
    titleKey: "stairs.mat.wood.title",
    descKey: "stairs.mat.wood.desc",
    tagKey: "stairs.mat.wood.tag"
  },
  {
    type: "wood-oak",
    titleKey: "stairs.mat.oak.title",
    descKey: "stairs.mat.oak.desc",
    tagKey: "stairs.mat.oak.tag"
  },
  {
    type: "wood-pine",
    titleKey: "stairs.mat.pine.title",
    descKey: "stairs.mat.pine.desc",
    tagKey: "stairs.mat.pine.tag"
  },
  {
    type: "wood-beech",
    titleKey: "stairs.mat.beech.title",
    descKey: "stairs.mat.beech.desc",
    tagKey: "stairs.mat.beech.tag"
  }
];
---

<Layout 
  lang={urlLang}
  title={`${t['stairs.title']} | MHG Barandas Huertas`}
  description={t['stairs.sub']}
>
  <!-- HERO HEAD -->
  <section class="page-header">
    <div class="container">
      <div class="gold-frame page-header-frame">
        <div class="gold-frame-inner text-center page-header-inner">
          <span class="subheading-tag" data-i18n="header.tagline">{t['header.tagline']}</span>
          <h1 class="heading-serif page-title" data-i18n="stairs.title">{t['stairs.title']}</h1>
          <div class="gold-divider"><span class="gold-divider-icon">◆</span></div>
          <p class="page-subtitle" data-i18n="stairs.sub">{t['stairs.sub']}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FLYER HIGHLIGHT (A52 ASSETS SHOWCASE) -->
  <section class="section-pasamanos-showcase">
    <div class="container">
      <div class="showcase-box-grid">
        <div class="showcase-media gold-frame">
          <div class="gold-frame-inner overflow-hidden">
            <img src="/assets/A52.jpg" alt="Pasamanos de Pared MHG Huertas" class="showcase-flyer-img" width="500" height="600" />
          </div>
        </div>

        <div class="showcase-details">
          <span class="subheading-tag" data-i18n="stairs.heroTag">{t['stairs.heroTag']}</span>
          <h2 class="heading-serif showcase-title" data-i18n="stairs.heroTitle">{t['stairs.heroTitle']}</h2>
          <div class="gold-mini-line"></div>
          <p class="showcase-lead" data-i18n="stairs.heroLead">
            {t['stairs.heroLead']}
          </p>

          <div class="specs-grid">
            <div class="spec-card">
              <h4 data-i18n="stairs.spec1.t">{t['stairs.spec1.t']}</h4>
              <p data-i18n="stairs.spec1.d">{t['stairs.spec1.d']}</p>
            </div>
            <div class="spec-card">
              <h4 data-i18n="stairs.spec2.t">{t['stairs.spec2.t']}</h4>
              <p data-i18n="stairs.spec2.d">{t['stairs.spec2.d']}</p>
            </div>
            <div class="spec-card">
              <h4 data-i18n="stairs.spec3.t">{t['stairs.spec3.t']}</h4>
              <p data-i18n="stairs.spec3.d">{t['stairs.spec3.d']}</p>
            </div>
            <div class="spec-card">
              <h4 data-i18n="stairs.spec4.t">{t['stairs.spec4.t']}</h4>
              <p data-i18n="stairs.spec4.d">{t['stairs.spec4.d']}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MATERIALES DISPONIBLES GRID (A52.JPG REPLICATION) -->
  <section class="section-disponibles">
    <div class="container">
      <div class="text-center section-header">
        <span class="subheading-tag" data-i18n="stairs.matSub">{t['stairs.matSub']}</span>
        <h2 class="heading-serif section-title" data-i18n="stairs.matTitle">{t['stairs.matTitle']}</h2>
        <div class="gold-divider"><span class="gold-divider-icon">◆</span></div>
      </div>

      <div class="materials-grid">
        {pasamanosOptions.map(option => (
          <div class="mat-card">
            <div class="mat-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            </div>
            <span class="mat-tag" data-i18n={option.tagKey}>{t[option.tagKey as keyof typeof t]}</span>
            <h3 class="mat-title" data-i18n={option.titleKey}>{t[option.titleKey as keyof typeof t]}</h3>
            <p class="mat-desc" data-i18n={option.descKey}>{t[option.descKey as keyof typeof t]}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- REAL PHOTOS SHOWCASE -->
  <section class="section-photos-real">
    <div class="container">
      <div class="gold-frame photos-frame">
        <div class="gold-frame-inner photos-inner text-center">
          <span class="subheading-tag" data-i18n="stairs.photosSub">{t['stairs.photosSub']}</span>
          <h2 class="heading-serif photos-title" data-i18n="stairs.photosTitle">{t['stairs.photosTitle']}</h2>
          <p class="photos-subtitle" data-i18n="stairs.photosDesc">{t['stairs.photosDesc']}</p>
          
          <div class="real-gallery-grid">
            <div class="real-photo-card">
              <img src="/assets/A5.jpg" alt="Trabajo Real Baranda Madera" width="300" height="260" />
              <span class="real-photo-caption" data-i18n="stairs.pic1">{t['stairs.pic1']}</span>
            </div>
            <div class="real-photo-card">
              <img src="/assets/A52.jpg" alt="Trabajo Real Pasamanos Acero" width="300" height="260" />
              <span class="real-photo-caption" data-i18n="stairs.pic2">{t['stairs.pic2']}</span>
            </div>
            <div class="real-photo-card">
              <img src="/assets/VINILOS.jpg" alt="Colección Trabajo Real MHG" width="300" height="260" />
              <span class="real-photo-caption" data-i18n="stairs.pic3">{t['stairs.pic3']}</span>
            </div>
          </div>

          <div class="photos-cta">
            <a href="/contacto" class="btn-hero-gold" data-i18n="stairs.btnMeasure">{t['stairs.btnMeasure']}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: 50px 0 30px;
    background-color: var(--color-bg);
  }

  .page-header-frame {
    background: var(--color-dark-box);
    color: var(--color-dark-box-text);
  }

  .page-header-inner {
    padding: 40px 24px;
  }

  .page-title {
    font-size: 2.2rem;
    color: var(--color-gold-light);
    letter-spacing: 0.1em;
    margin-top: 4px;
  }

  .page-subtitle {
    max-width: 600px;
    margin: 0 auto;
    font-size: 0.95rem;
    color: #BBB0A3;
  }

  .section-pasamanos-showcase {
    padding: 60px 0;
    background-color: var(--color-bg);
  }

  .showcase-box-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 40px;
    align-items: center;
  }

  .showcase-media {
    background: #141210;
  }

  .overflow-hidden {
    overflow: hidden;
  }

  .showcase-flyer-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .showcase-flyer-img:hover {
    transform: scale(1.03);
  }

  .showcase-title {
    font-size: 1.9rem;
    color: var(--color-text-main);
  }

  .gold-mini-line {
    width: 40px;
    height: 2px;
    background-color: var(--color-gold);
    margin: 10px 0 18px;
  }

  .showcase-lead {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-bottom: 24px;
    line-height: 1.6;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .spec-card {
    background: var(--color-card);
    padding: 16px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-card-border);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .spec-card h4 {
    font-family: var(--font-serif);
    color: var(--color-gold-dark);
    font-size: 1rem;
    margin-bottom: 4px;
  }

  .spec-card p {
    font-size: 0.84rem;
    color: var(--color-text-muted);
    flex-grow: 1;
  }

  /* MATERIALS GRID */
  .section-disponibles {
    padding: 60px 0 80px;
    background-color: var(--color-bg-alt);
  }

  .materials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 36px;
  }

  .mat-card {
    background: var(--color-card);
    padding: 24px 18px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-card-border);
    box-shadow: var(--shadow-sm);
    text-align: center;
    position: relative;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .mat-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-gold);
  }

  .mat-icon {
    color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
  }

  .mat-tag {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-gold-dark);
    background: rgba(181, 149, 103, 0.12);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  .mat-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--color-text-main);
    margin-bottom: 8px;
  }

  .mat-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    flex-grow: 1;
  }

  /* REAL PHOTOS SECTION */
  .section-photos-real {
    padding: 40px 0 80px;
    background-color: var(--color-bg);
  }

  .photos-frame {
    background: var(--color-dark-box);
    color: var(--color-dark-box-text);
  }

  .photos-inner {
    padding: 44px 24px;
  }

  .photos-title {
    color: var(--color-gold-light);
    font-size: 1.9rem;
    letter-spacing: 0.1em;
    margin-top: 4px;
    margin-bottom: 6px;
  }

  .photos-subtitle {
    color: #B3AAA0;
    font-size: 0.92rem;
    max-width: 600px;
    margin: 0 auto 32px;
  }

  .real-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  .real-photo-card {
    background: #141210;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid rgba(181, 149, 103, 0.3);
  }

  .real-photo-card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    object-position: top center;
  }

  .real-photo-caption {
    display: block;
    padding: 10px;
    font-size: 0.8rem;
    color: var(--color-gold-light);
    letter-spacing: 0.05em;
  }

  .btn-hero-gold {
    background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-dark) 100%);
    color: #FFF;
    padding: 12px 28px;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    display: inline-block;
  }

  @media (max-width: 900px) {
    .showcase-box-grid {
      grid-template-columns: 1fr;
    }
    .specs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
